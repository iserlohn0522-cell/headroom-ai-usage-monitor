{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headroom.local/schemas/allowance-provider-v1.json",
  "title": "Headroom allowance snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "providerId",
    "displayName",
    "observedAt",
    "status",
    "windows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 40
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "loading",
        "error"
      ]
    },
    "windows": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "support"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "support": {
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "remainingPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "state": {
            "enum": [
              "fresh",
              "loading",
              "stale",
              "error",
              "unknown"
            ]
          },
          "reset": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "fixed",
                  "rolling",
                  "unknown"
                ]
              },
              "at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "support": {
                  "enum": [
                    "unsupported",
                    "unknown"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "remainingPercent": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "remainingPercent": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
